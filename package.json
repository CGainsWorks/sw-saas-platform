{
  "name": "sw-saas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS platform: Next.js web, Node.js REST + GraphQL API, Postgres with row-level security, Redis, EKS.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace apps/api",
    "test:isolation": "npm run test:isolation --workspace apps/api",
    "migrate": "npm run migrate --workspace apps/api",
    "seed": "npm run seed --workspace apps/api",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

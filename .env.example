# Copy to .env for local development:  cp .env.example .env
#
# Every value here is a development default for services bound to localhost. None of
# them are secrets and none are used outside a dev machine. Production values come from
# AWS Secrets Manager via External Secrets — see docs/runbook.md.

NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

# --- database -----------------------------------------------------------------
# The API connects as app_user: NOSUPERUSER, NOBYPASSRLS, owns nothing.
# Pointing this at the postgres superuser would disable tenant isolation, so the API
# refuses to boot if the role it connects as can bypass RLS (see db/pool.ts).
DATABASE_URL=postgres://app_user:app_dev_password@localhost:5433/saas
# Used only by migrations and seeding. Never by a request path.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/saas

PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=10000

# --- redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- tokens issued by this API -------------------------------------------------
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=saas-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Leave the keypair unset in development and an ephemeral RS256 pair is generated at
# boot (tokens then do not survive a restart, which is fine locally). Required in
# production: the API refuses to start without them.
# JWT_PRIVATE_KEY_B64=
# JWT_PUBLIC_KEY_B64=

# --- OIDC provider -------------------------------------------------------------
# Defaults point at the in-repo dev IdP (apps/dev-idp), which implements a real
# authorization-code + PKCE flow so the login path is exercised end to end without an
# external account. Swap these four values for Auth0 / Google / Keycloak unchanged.
OIDC_ISSUER=http://localhost:4010
OIDC_CLIENT_ID=saas-web
OIDC_CLIENT_SECRET=dev-client-secret
OIDC_REDIRECT_URI=http://localhost:4000/v1/auth/callback

# --- web -----------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- limits --------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
GRAPHQL_MAX_DEPTH=10
GRAPHQL_INTROSPECTION=true
